# ==============================================================================
# Kasirio Cloud Backend Environment Variables (.env.example)
# Acuan: docs/KASIRIO_CLOUD_BACKEND_BLUEPRINT_v1.0.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL Multi-Tenant - Supabase / Neon / Local)
# ------------------------------------------------------------------------------
# Format untuk Supabase / Neon (Wajib sslmode=require di production):
# postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://kasirio_user:strong_password@localhost:5432/kasirio_cloud?schema=public"

# ------------------------------------------------------------------------------
# 3. REALM-ISOLATED JWT SECRETS (Blueprint Bagian 1 & 6.1)
# Wajib signing key berbeda per realm sebagai defense-in-depth
# ------------------------------------------------------------------------------
JWT_SECRET_APP="generate-random-base64-secret-min-32-chars-for-tenant-app"
JWT_SECRET_OFFICE="generate-random-base64-secret-min-32-chars-for-platform-office"

# ------------------------------------------------------------------------------
# 4. EMERGENCY BREAK-GLASS AUTHENTICATION (Blueprint Bagian 5.5)
# Digunakan hanya saat tim terkunci dari Cloudflare Access.
# Simpan nilai rahasia ini di brankas terisolasi / Secret Manager.
# ------------------------------------------------------------------------------
BREAK_GLASS_SECRET="kasirio-emergency-break-glass-fido2-key-2026"

# ------------------------------------------------------------------------------
# 5. GCP CLOUD SCHEDULER CRON AUTHENTICATION
# Digunakan untuk otorisasi POST /api/internal/jobs/subscription-lifecycle
# ------------------------------------------------------------------------------
CRON_SECRET="generate-high-entropy-cron-secret-for-cloud-scheduler-invoker"

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE ACCESS ZERO TRUST INTEGRATION (Opsional untuk Verifikasi Header)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCESS_TEAM_DOMAIN="kasirio-team.cloudflareaccess.com"
CLOUDFLARE_ACCESS_AUD="your-cloudflare-access-application-aud-tag"

# ------------------------------------------------------------------------------
# 7. AI SERVICES (Gemini API for OCR Nota Pasar & Business Briefing)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 8. INTEGRATION PROVIDERS (Email & WhatsApp - Blueprint Bagian 5.4)
# Kunci enkripsi AES untuk tabel integrationProviders.credentialsEncrypted
# ------------------------------------------------------------------------------
CREDENTIALS_ENCRYPTION_KEY="32-bytes-aes-key-for-storing-integration-secrets"
