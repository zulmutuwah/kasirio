// Skema Prisma untuk Produksi PostgreSQL Kasirio
// Salin isi ini ke prisma/schema.prisma saat menghubungkan ke PostgreSQL (Supabase / Neon / Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String      @id @default(uuid())
  name         String
  slug         String      @unique
  businessType String      @default("RETAIL") @map("business_type") // RETAIL | FNB
  phone        String?
  address      String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  outlets             Outlet[]
  users               User[]
  products            Product[]
  categories          Category[]
  transactions        Transaction[]
  stockLogs           StockLog[]
  customers           Customer[]
  cashSessions        CashSession[]
  auditLogs           AuditLog[]
  syncLogs            SyncMutationLog[]
  permissionOverrides UserPermissionOverride[]
  subscriptions       Subscription[]
  tenantOwnerships    TenantOwnership[]
  authPolicy          TenantAuthPolicy?
  payments            Payment[]
  notificationLogs    NotificationLog[]
  userSessions        UserSession[]

  @@map("tenants")
}

model Outlet {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  name         String
  address      String?
  phone        String?
  isMainBranch Boolean     @default(false) @map("is_main_branch")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users               User[]
  products            Product[]
  transactions        Transaction[]
  stockLogs           StockLog[]
  cashSessions        CashSession[]
  auditLogs           AuditLog[]
  syncLogs            SyncMutationLog[]
  permissionOverrides UserPermissionOverride[]

  @@index([tenantId])
  @@map("outlets")
}

model User {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  outletId     String?     @map("outlet_id")
  name         String
  email        String?
  phone        String?
  passwordHash String?     @map("password_hash")
  pinHash      String      @map("pin_hash") // Hashed PIN untuk otorisasi POS
  role         String      @default("CASHIER") // DEVELOPER | SUPER_ADMIN | OWNER | ADMIN | CASHIER
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet              Outlet?     @relation(fields: [outletId], references: [id])
  cashSessions        CashSession[]
  permissionOverrides UserPermissionOverride[]
  tenantOwnerships    TenantOwnership[]
  userSessions        UserSession[]

  @@index([tenantId])
  @@index([outletId])
  @@map("users")
}

model Subscription {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  status          String    @default("TRIAL") // TRIAL | ACTIVE | GRACE | LIMITED | SUSPENDED
  trialEndsAt     DateTime  @map("trial_ends_at")
  graceEndsAt     DateTime? @map("grace_ends_at")
  activeEndsAt    DateTime? @map("active_ends_at")
  planType        String    @default("PRO") @map("plan_type")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model TenantOwnership {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tenantId    String   @map("tenant_id")
  isPrimary   Boolean  @default(true) @map("is_primary")
  billingType String   @default("PRIMARY") @map("billing_type") // PRIMARY | ADDITIONAL_TENANT
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_ownerships")
}

model TenantAuthPolicy {
  id                     String   @id @default(uuid())
  tenantId               String   @unique @map("tenant_id")
  manualDiscountMode     String   @default("THRESHOLD") @map("manual_discount_mode") // ALLOW | THRESHOLD | ALWAYS_PIN
  manualDiscountPercent  Float    @default(10) @map("manual_discount_percent")
  manualProductAddMode   String   @default("ALLOW") @map("manual_product_add_mode")
  priceOverrideMode      String   @default("ALWAYS_PIN") @map("price_override_mode")
  priceOverridePercent   Float    @default(5) @map("price_override_percent")
  voidTransactionMode    String   @default("ALWAYS_PIN") @map("void_transaction_mode")
  refundMode             String   @default("ALWAYS_PIN") @map("refund_mode")
  refundThresholdAmount  Float    @default(50000) @map("refund_threshold_amount")
  drawerOpenManualMode   String   @default("ALWAYS_PIN") @map("drawer_open_manual_mode")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_auth_policies")
}

model SystemConfig {
  id               String   @id @default(uuid())
  key              String   @unique // grace_period_days, additional_tenant_price, max_concurrent_sessions, default_pin_thresholds
  value            String   // JSON or serialized string
  description      String?
  updatedByStaffId String?  @map("updated_by_staff_id")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("system_configs")
}

model Payment {
  id                      String        @id @default(uuid())
  tenantId                String        @map("tenant_id")
  subscriptionId          String?       @map("subscription_id")
  amount                  Float
  koinAmount              Float?        @map("koin_amount")
  rupiahPerKoinAtPurchase Float?        @map("rupiah_per_koin_at_purchase")
  status                  String        @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | VERIFIED | REJECTED
  referenceNumber         String        @unique @map("reference_number")
  verifiedByStaffId       String?       @map("verified_by_staff_id")
  verifiedAt              DateTime?     @map("verified_at")
  rejectionReason         String?       @map("rejection_reason")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription            Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([referenceNumber])
  @@map("payments")
}

model KoinSetting {
  id              String   @id @default(uuid())
  rupiahPerKoin   Float    @default(1000) @map("rupiah_per_koin")
  minTopupKoin    Float    @default(50) @map("min_topup_koin")
  bundleDiscounts String?  @map("bundle_discounts") // JSON string
  updatedBy       String?  @map("updated_by")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("koin_settings")
}

model KoinPriceHistory {
  id            String    @id @default(uuid())
  rupiahPerKoin Float     @map("rupiah_per_koin")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  @@map("koin_price_histories")
}

model UserSession {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  tenantId          String   @map("tenant_id")
  deviceFingerprint String   @map("device_fingerprint")
  ipAddress         String   @map("ip_address")
  userAgent         String?  @map("user_agent")
  refreshTokenId    String   @unique @map("refresh_token_id")
  isRevoked         Boolean  @default(false) @map("is_revoked")
  loginAt           DateTime @default(now()) @map("login_at")
  lastActiveAt      DateTime @default(now()) @map("last_active_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([refreshTokenId])
  @@map("user_sessions")
}

model IntegrationProvider {
  id                   String    @id @default(uuid())
  type                 String    // EMAIL | WHATSAPP
  providerName         String    @map("provider_name") // e.g. Mailketing, KirimEmail, Fonnte, Wablas
  credentialsEncrypted String    @map("credentials_encrypted") // AES encrypted JSON credentials
  isActive             Boolean   @default(false) @map("is_active")
  lastTestStatus       String?   @map("last_test_status")
  lastTestedAt         DateTime? @map("last_tested_at")
  updatedBy            String?   @map("updated_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("integration_providers")
}

model NotificationTemplate {
  id           String   @id @default(uuid())
  type         String   // TRIAL_H7 | TRIAL_H3 | TRIAL_H1 | ENTER_GRACE | ENTER_LIMITED
  channel      String   // APP | EMAIL | WHATSAPP
  subject      String?
  bodyTemplate String   @map("body_template")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model NotificationLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  type      String   // TRIAL_H7 | TRIAL_H3 | TRIAL_H1 | ENTER_GRACE | ENTER_LIMITED
  channel   String   // APP | EMAIL | WHATSAPP
  recipient String
  sentAt    DateTime @default(now()) @map("sent_at")
  status    String   // SENT | FAILED

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, channel])
  @@index([tenantId])
  @@map("notification_logs")
}

model Category {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  outletId      String?           @map("outlet_id")
  sku           String?
  barcode       String?
  name          String
  buyPrice      Float             @default(0) @map("buy_price")
  sellPrice     Float             @map("sell_price")
  stock         Float             @default(0)
  minStockAlert Float             @default(5) @map("min_stock_alert")
  unit          String            @default("Pcs")
  categoryId    String?           @map("category_id")
  deletedAt     DateTime?         @map("deleted_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet        Outlet?           @relation(fields: [outletId], references: [id])
  category      Category?         @relation(fields: [categoryId], references: [id])
  items         TransactionItem[]
  stockLogs     StockLog[]

  @@index([tenantId])
  @@index([barcode])
  @@index([sku])
  @@map("products")
}

model Transaction {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  outletId        String            @map("outlet_id")
  invoiceNumber   String            @map("invoice_number")
  date            DateTime          @default(now())
  subtotal        Float
  discount        Float             @default(0)
  tax             Float             @default(0)
  total           Float
  cashierGiven    Float?            @map("cashier_given")
  changeDue       Float?            @map("change_due")
  paymentMethod   String            @map("payment_method") // CASH | QRIS | TRANSFER | DEBT
  status          String            @default("COMPLETED") // COMPLETED | VOID | REFUND
  cashierId       String?           @map("cashier_id")
  cashierName     String            @map("cashier_name")
  customerId      String?           @map("customer_id")
  customerName    String?           @map("customer_name")
  notes           String?
  isAuditFlagged  Boolean           @default(false) @map("is_audit_flagged")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet          Outlet            @relation(fields: [outletId], references: [id])
  items           TransactionItem[]

  @@index([tenantId])
  @@index([outletId])
  @@index([date])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  productId     String      @map("product_id")
  productName   String      @map("product_name")
  quantity      Float
  buyPrice      Float       @default(0) @map("buy_price")
  sellPrice     Float       @map("sell_price")
  discount      Float       @default(0)
  subtotal      Float

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@map("transaction_items")
}

model StockLog {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  outletId      String      @map("outlet_id")
  productId     String      @map("product_id")
  productName   String      @map("product_name")
  type          String      // IN | OUT | ADJUSTMENT | VOID | TRANSFER
  quantity      Float
  previousStock Float       @map("previous_stock")
  currentStock  Float       @map("current_stock")
  notes         String?
  date          DateTime    @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([outletId])
  @@index([productId])
  @@index([date])
  @@map("stock_logs")
}

model Customer {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  name         String
  phone        String?
  address      String?
  totalDebt    Float            @default(0) @map("total_debt")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  debtLogs     DebtPaymentLog[]

  @@index([tenantId])
  @@map("customers")
}

model DebtPaymentLog {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  customerId    String    @map("customer_id")
  amount        Float
  paymentMethod String    @default("CASH") @map("payment_method")
  notes         String?
  date          DateTime  @default(now())

  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("debt_payment_logs")
}

model CashSession {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  outletId       String    @map("outlet_id")
  cashierId      String    @map("cashier_id")
  cashierName    String    @map("cashier_name")
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  openingBalance Float     @map("opening_balance")
  expectedCash   Float?    @map("expected_cash")
  actualCash     Float?    @map("actual_cash")
  difference     Float?
  status         String    @default("OPEN") // OPEN | CLOSED
  notes          String?

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet         Outlet    @relation(fields: [outletId], references: [id])
  cashier        User      @relation(fields: [cashierId], references: [id])

  @@index([tenantId])
  @@index([outletId])
  @@map("cash_sessions")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  outletId    String?  @map("outlet_id")
  timestamp   DateTime @default(now())
  type        String   // VOID_TRANSACTION | LARGE_DISCOUNT | DRAWER_OPEN | MANUAL_SYNC | LOGIN | PLATFORM_ACCESS | PLATFORM_SYSTEM_CONFIG_UPDATE | BREAK_GLASS_ACCESS
  details     String
  cashierName String   @map("cashier_name")
  actorRole   String?  @map("actor_role") // DEVELOPER | SUPER_ADMIN | OWNER | ADMIN | CASHIER
  actorId     String?  @map("actor_id") // ID pelaksana aksi

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet?  @relation(fields: [outletId], references: [id])

  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_logs")
}

model SyncMutationLog {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  outletId        String   @map("outlet_id")
  deviceId        String   @map("device_id")
  entityType      String   @map("entity_type") // TRANSACTION | PRODUCT | STOCK_LOG | CUSTOMER | DEBT_PAYMENT | AUDIT_LOG
  entityId        String   @map("entity_id")
  action          String   // CREATE | UPDATE | DELETE
  payload         String   // JSON string
  clientTimestamp DateTime @map("client_timestamp")
  serverTimestamp DateTime @default(now()) @map("server_timestamp")

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet          Outlet   @relation(fields: [outletId], references: [id])

  @@index([tenantId])
  @@index([outletId])
  @@index([serverTimestamp])
  @@map("sync_mutation_logs")
}

model UserPermissionOverride {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tenantId   String   @map("tenant_id")
  outletId   String?  @map("outlet_id") // null = all outlets in tenant
  permission String
  type       String   // GRANT | REVOKE
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet     Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([outletId])
  @@map("user_permission_overrides")
}
